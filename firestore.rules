rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ---- Cardápio e configurações: leitura pública, escrita só admin ----
    // config/pix (chave e recebedor), config/equipe (todos os WhatsApp
    // da equipe) e config/mesasPrivado (códigos dos QR Codes das mesas)
    // são privados: só o admin lê. O site usa config/loja, que tem apenas
    // os números marcados para receber pedidos, e config/mesas (quantidade).
    match /config/{docId} {
      allow read: if !(docId in ['pix', 'equipe', 'mesasPrivado']) || isAdmin();
      allow write: if isAdmin();
    }
    match /categorias/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /produtos/{prodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Relatórios: totais por dia, sem nenhum dado de cliente ----
    match /relatorios/{dia} {
      allow read, write: if isAdmin();
    }
    // Resumo diário do painel de gestão (modos, mais vendidos, tempos): só admin
    match /resumos/{dia} {
      allow read, write: if isAdmin();
    }

    // ---- Pedidos ----
    match /pedidos/{orderId} {
      // Pedidos só são criados pela Cloud Function criarPedido, que recalcula
      // preços e taxa no servidor e grava apenas os campos permitidos.
      allow create: if false;
      // O cliente acompanha o próprio pedido pelo ID (aleatório, 20 caracteres).
      // "get" ≠ "list": ninguém consegue listar os pedidos dos outros.
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    // ---- Legado: transações antigas (podem conter endereço). Só o admin
    //      lê e apaga; ninguém mais grava. Apague-as pelo painel. ----
    match /transacoes/{orderId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }
    match /emails/{emailId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // ---- Administradores ----
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false; // só via Cloud Function (Admin SDK)
    }

    // ---- Contadores anti-abuso (limite de pedidos) ----
    // Só as Cloud Functions (Admin SDK) leem e gravam; o navegador nunca.
    match /_limites/{id} {
      allow read, write: if false;
    }
  }
}
